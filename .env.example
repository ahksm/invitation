# Скопируйте в .env и заполните. Настоящие ключи храните только в .env или в секретах хостинга.
# NODE_ENV здесь не задаётся: Dockerfile и docker-compose.yml ставят production (с проверками
# ключей и запретом тестовых провайдеров), npm run dev — development.
PORT=3000
# Публичный адрес сайта. Для мини-аппа и кнопок в боте нужен https.
APP_URL=http://localhost:3000
APP_NAME=Invitations
# Сколько прокси (nginx, балансировщик) стоит перед приложением, обычно 1, или их адреса и подсети
# через запятую (127.0.0.1,10.0.0.0/8). От этого зависят IP клиента в лимитах и проверка MULTICARD_CALLBACK_IPS.
# С числом порт приложения не должен быть доступен из интернета в обход прокси. true не принимается.
TRUST_PROXY=false
DATABASE_URL=postgres://invite:invite@localhost:5432/invite
REDIS_URL=redis://localhost:6379
# Длинная случайная строка, например: openssl rand -hex 32
JWT_SECRET=
# Каталог загруженных файлов (картинки, музыка, видео). В Docker — отдельный том.
MEDIA_DIR=./data/media
# Кто попадает в админку: Telegram ID и/или телефоны 998XXXXXXXXX через запятую.
ADMIN_TELEGRAM_IDS=
ADMIN_PHONES=

# Telegram-бот (@BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# polling для локальной разработки, webhook на сервере, off чтобы выключить бота.
TELEGRAM_MODE=polling
# Обязателен при TELEGRAM_MODE=webhook: им Telegram подписывает запросы к /telegram/webhook.
TELEGRAM_WEBHOOK_SECRET=

# Оплата: multicard или mock (тестовая страница оплаты, запрещена в production).
PAYMENT_PROVIDER=mock
CURRENCY=UZS
# Тест: https://dev-mesh.multicard.uz, боевой: https://mesh.multicard.uz
MULTICARD_BASE_URL=https://dev-mesh.multicard.uz
MULTICARD_APPLICATION_ID=
MULTICARD_SECRET=
MULTICARD_STORE_ID=
# ИКПУ и код упаковки услуги с tasnif.soliq.uz: обязательны, без них Multicard не создаёт счёт.
MULTICARD_MXIK=
MULTICARD_PACKAGE_CODE=
# Ставка НДС в чеке, % (пусто: не передаётся).
MULTICARD_VAT=
# IP, с которых принимать колбэки (у Multicard 195.158.26.90). Пусто: проверяется только подпись.
# Включайте, только если TRUST_PROXY настроен верно, иначе настоящие оплаты будут отменены.
MULTICARD_CALLBACK_IPS=

# SMS: eskiz или mock (SMS пишутся в лог, запрещено в production).
SMS_PROVIDER=mock
ESKIZ_BASE_URL=https://notify.eskiz.uz/api
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546
# Тестовый аккаунт Eskiz пропускает только фразу «This is test from Eskiz»: с true она уходит вместо
# настоящего текста, а сам текст с кодом пишется в лог. Только для разработки.
ESKIZ_TEST_MODE=false
# Секрет в адресе колбэка о доставке SMS; без него статусы доставки не обновляются.
SMS_CALLBACK_SECRET=

# Помощник с текстом приглашения (Anthropic API). Пусто: помощник выключен.
ANTHROPIC_API_KEY=
# Модель помощника (по умолчанию claude-opus-5-5).
AI_MODEL=
